# ---------------------------------------------------------------------------
# Backend (server-side only - these never reach the browser)
# ---------------------------------------------------------------------------

# Anthropic API key, used for runtime risk explanations and grounded Q&A.
# Leave blank to run without AI: the app stays fully usable and falls back to
# evidence-only summaries that are clearly labelled as such in the UI.
ANTHROPIC_API_KEY=

# Claude model used for explanations and Q&A.
MODEL_NAME=claude-opus-5

# Comma-separated list of browser origins allowed to call the API.
# Local development:  http://localhost:3000
# Production:         https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_ values ARE visible in the browser - never put a
# secret here, and never create NEXT_PUBLIC_ANTHROPIC_API_KEY)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend.
# Local:      http://localhost:8000
# Production: https://your-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
